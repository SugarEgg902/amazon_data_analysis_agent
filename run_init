检测缺少某个站点的数据
SELECT DISTINCT t23.market
FROM table_name t23
WHERE t23.brand = 'blackview'
  AND DATE(t23.crawl_date) = '2026-06-23'
  AND NOT EXISTS (
      SELECT 1
      FROM table_name t24
      WHERE t24.brand = t23.brand
        AND t24.market = t23.market
        AND DATE(t24.crawl_date) = '2026-06-24'
  );