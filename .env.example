# .env.example —— docker-compose 用的凭据模板
# 首次部署:
#     cp .env.example .env
# 然后填入真值。.env 已在 .gitignore 中,不会进仓库(本仓库是公开的)。

# 数据库密码
DB_PASS=请填入数据库密码

# 卖家精灵(cookie 过期时用账号密码自动重登刷新)
SELLERSPRITE_COOKIE=
SELLERSPRITE_EMAIL=请填入账号
SELLERSPRITE_PASSWORD=请填入密码哈希
SELLERSPRITE_SALT=请填入 salt

# 钉钉自定义机器人(加签模式)
DINGTALK_ACCESS_TOKEN=请填入 access_token
DINGTALK_SECRET=请填入 SEC 开头的加签密钥

# 阿里云 OSS(图表托管;RAM 子账号,只授予该 bucket 的 PutObject/GetObject)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=请填入 bucket 名
REPORT_EMBED_CHARTS=1
